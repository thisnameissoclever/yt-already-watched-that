{
  "manifest_version": 3,
  "name": "Stop YouTube Reruns",
  "description": "Hide watched videos across YouTube recommendations, feeds, channel videos, search results, and playlists.",
  "version": "0.1.2",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_title": "Stop YouTube Reruns",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "settings.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
